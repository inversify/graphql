  },
  "devDependencies": {
    "@as-integrations/express5": "1.1.2",
    "@as-integrations/fastify": "3.1.0",
    "@graphql-tools/utils": "12.0.3",
    "@inversifyjs/apollo-express": "workspace:*",
    "@inversifyjs/apollo-fastify": "workspace:*",
    "@inversifyjs/http-express": "5.6.1",
    "@inversifyjs/http-fastify": "5.6.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "fastify": "5.12.5",
    "graphql": "17.0.2",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "homepage": "https://inversify.io/framework/",
  "keywords": [
    "apollo",
    "inversify",
    "graphql",
    "http",
