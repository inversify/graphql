    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "module": "lib/esm/index.js",
  "exports": {
    ".": "./lib/esm/index.js"
  },
  "name": "@inversifyjs/apollo-subscription-ws",
  "peerDependencies": {
    "@apollo/server": "^5.5.1",
