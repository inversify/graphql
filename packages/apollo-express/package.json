{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/graphql/issues"
  },
  "description": "InversifyJs GraphQL Apollo express package",
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@inversifyjs/apollo-core": "workspace:*"
  },
  "devDependencies": {
    "@inversifyjs/http-express": "5.4.8",
    "@graphql-tools/utils": "11.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "homepage": "https://inversify.io/framework/",
  "keywords": [
    "apollo",
    "inversify",
    "graphql",
    "http",
    "node",
    "typescript"
  ],
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^11.0.0"
  },
  "license": "MIT",
  "module": "lib/esm/index.js",
  "exports": {
    ".": "./lib/esm/index.js"
  },
  "name": "@inversifyjs/apollo-express",
  "peerDependencies": {
    "@apollo/server": "^5.5.1",
    "@inversifyjs/http-core": "^5.4.8",
    "inversify": "^8.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/graphql.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "prettier --write ./src",
    "lint": "eslint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "type": "module",
  "version": "0.8.1"
}
